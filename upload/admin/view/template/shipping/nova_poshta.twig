{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" name="shipping_nova_poshta_api_key" value="{{ shipping_nova_poshta_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control" autocomplete="off"/>
                <button type="button" id="button-test" data-test-url="{{ test }}" class="btn btn-outline-secondary"><i class="fa-solid fa-plug"></i> {{ button_test }}</button>
              </div>
              <div id="test-result" class="form-text"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-default-cost" class="col-sm-2 col-form-label">{{ entry_default_cost }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_nova_poshta_default_cost" value="{{ shipping_nova_poshta_default_cost }}" placeholder="0.00" id="input-default-cost" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_nova_poshta_tax_class_id" id="input-tax-class" class="form-select">
                <option value="0">{{ text_none|default('None') }}</option>
                {% for tax_class in tax_classes %}
                  <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_nova_poshta_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="shipping_nova_poshta_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones|default('All Zones') }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_nova_poshta_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="shipping_nova_poshta_status" value="0"/>
                <input type="checkbox" name="shipping_nova_poshta_status" value="1" id="input-status" class="form-check-input"{% if shipping_nova_poshta_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_nova_poshta_sort_order" value="{{ shipping_nova_poshta_sort_order }}" placeholder="0" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
document.getElementById('button-test').addEventListener('click', (e) => {
  const btn = e.currentTarget;
  const url = btn.dataset.testUrl;
  const key = document.getElementById('input-api-key').value.trim();
  const result = document.getElementById('test-result');
  result.textContent = '...';
  result.className = 'form-text text-muted';
  fetch(url, {
    method: 'POST',
    headers: {'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest'},
    body: new URLSearchParams({shipping_nova_poshta_api_key: key})
  })
  .then(r => r.json())
  .then(d => {
    if (d.success) {
      result.textContent = d.success;
      result.className = 'form-text text-success';
    } else {
      result.textContent = d.error || 'Unknown error';
      result.className = 'form-text text-danger';
    }
  })
  .catch(e => {
    result.textContent = 'Request failed: ' + e.message;
    result.className = 'form-text text-danger';
  });
});
</script>
{{ footer }}
