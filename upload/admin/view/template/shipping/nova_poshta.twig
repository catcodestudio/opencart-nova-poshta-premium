{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <div class="alert alert-info d-flex justify-content-between align-items-center mb-3">
          <span><i class="fa-solid fa-tools"></i> {{ text_section_links }}:
            <button type="button" id="button-setup" data-url="{{ setup_url }}" class="btn btn-sm btn-warning ms-2"><i class="fa-solid fa-screwdriver-wrench"></i> {{ button_setup }}</button>
            <a href="{{ shipments_url }}" class="btn btn-sm btn-info ms-2"><i class="fa-solid fa-truck"></i> {{ button_shipments }}</a>
            <span id="setup-result" class="ms-2"></span>
          </span>
        </div>

        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <h5 class="text-muted mb-3"><i class="fa-solid fa-key"></i> {{ text_section_api }}</h5>
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" name="shipping_nova_poshta_api_key" value="{{ shipping_nova_poshta_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control" autocomplete="off"/>
                <button type="button" id="button-test" data-test-url="{{ test }}" class="btn btn-outline-secondary"><i class="fa-solid fa-plug"></i> {{ button_test }}</button>
              </div>
              <div id="test-result" class="form-text"></div>
            </div>
          </div>

          <h5 class="text-muted mb-3 mt-4"><i class="fa-solid fa-warehouse"></i> {{ text_section_sender }}</h5>
          <div class="row mb-3">
            <label for="input-city-search" class="col-sm-2 col-form-label">{{ entry_sender_city }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" id="input-city-search" class="form-control" placeholder="{{ entry_sender_city }}" value="{{ shipping_nova_poshta_sender_city_name }}" autocomplete="off"/>
                <button type="button" id="button-search-city" data-url="{{ search_cities }}" class="btn btn-outline-secondary"><i class="fa-solid fa-search"></i> {{ button_search }}</button>
              </div>
              <div id="city-results" class="list-group mt-2" style="display:none;"></div>
              <input type="hidden" name="shipping_nova_poshta_sender_city_ref" id="input-sender-city-ref" value="{{ shipping_nova_poshta_sender_city_ref }}"/>
              <input type="hidden" name="shipping_nova_poshta_sender_city_name" id="input-sender-city-name" value="{{ shipping_nova_poshta_sender_city_name }}"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-sender-warehouse" class="col-sm-2 col-form-label">{{ entry_sender_warehouse }}</label>
            <div class="col-sm-10">
              <select id="input-sender-warehouse" class="form-select" data-url="{{ get_warehouses }}" data-selected-ref="{{ shipping_nova_poshta_sender_warehouse_ref }}">
                {% if shipping_nova_poshta_sender_warehouse_ref %}
                  <option value="{{ shipping_nova_poshta_sender_warehouse_ref }}" selected>{{ shipping_nova_poshta_sender_warehouse_name }}</option>
                {% else %}
                  <option value="">— {{ text_pick_city }} —</option>
                {% endif %}
              </select>
              <input type="hidden" name="shipping_nova_poshta_sender_warehouse_ref" id="input-sender-warehouse-ref" value="{{ shipping_nova_poshta_sender_warehouse_ref }}"/>
              <input type="hidden" name="shipping_nova_poshta_sender_warehouse_name" id="input-sender-warehouse-name" value="{{ shipping_nova_poshta_sender_warehouse_name }}"/>
              <div class="form-text">
                <button type="button" id="button-quote" data-url="{{ quote_preview }}" class="btn btn-sm btn-outline-info mt-2"><i class="fa-solid fa-calculator"></i> {{ button_quote }}</button>
                <span id="quote-result" class="ms-2"></span>
              </div>
            </div>
          </div>

          <h5 class="text-muted mb-3 mt-4"><i class="fa-solid fa-robot"></i> {{ text_section_automation }}</h5>
          <div class="row mb-3">
            <label for="input-sender-cp" class="col-sm-2 col-form-label">{{ entry_sender_counterparty }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <select id="input-sender-cp" class="form-select" data-url="{{ url_counterparties }}" data-selected-ref="{{ shipping_nova_poshta_sender_counterparty_ref }}">
                  {% if shipping_nova_poshta_sender_counterparty_ref %}
                    <option value="{{ shipping_nova_poshta_sender_counterparty_ref }}" selected>{{ shipping_nova_poshta_sender_counterparty_name }}</option>
                  {% else %}
                    <option value="">—</option>
                  {% endif %}
                </select>
                <button type="button" id="button-load-cp" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate"></i> {{ button_load }}</button>
              </div>
              <input type="hidden" name="shipping_nova_poshta_sender_counterparty_ref" id="input-sender-cp-ref" value="{{ shipping_nova_poshta_sender_counterparty_ref }}"/>
              <input type="hidden" name="shipping_nova_poshta_sender_counterparty_name" id="input-sender-cp-name" value="{{ shipping_nova_poshta_sender_counterparty_name }}"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sender-contact" class="col-sm-2 col-form-label">{{ entry_sender_contact }}</label>
            <div class="col-sm-10">
              <select id="input-sender-contact" class="form-select" data-url="{{ url_contacts }}" data-selected-ref="{{ shipping_nova_poshta_sender_contact_ref }}">
                {% if shipping_nova_poshta_sender_contact_ref %}
                  <option value="{{ shipping_nova_poshta_sender_contact_ref }}" data-phone="{{ shipping_nova_poshta_sender_phone }}" selected>{{ shipping_nova_poshta_sender_contact_name }}</option>
                {% else %}
                  <option value="">—</option>
                {% endif %}
              </select>
              <input type="hidden" name="shipping_nova_poshta_sender_contact_ref" id="input-sender-contact-ref" value="{{ shipping_nova_poshta_sender_contact_ref }}"/>
              <input type="hidden" name="shipping_nova_poshta_sender_contact_name" id="input-sender-contact-name" value="{{ shipping_nova_poshta_sender_contact_name }}"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sender-phone" class="col-sm-2 col-form-label">{{ entry_sender_phone }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_nova_poshta_sender_phone" value="{{ shipping_nova_poshta_sender_phone }}" placeholder="380XXXXXXXXX" id="input-sender-phone" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-auto-ttn-status" class="col-sm-2 col-form-label">{{ entry_auto_ttn_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_nova_poshta_auto_ttn_status_id" id="input-auto-ttn-status" class="form-select">
                <option value="0">—</option>
                {% for s in order_statuses %}
                  <option value="{{ s.order_status_id }}"{% if s.order_status_id == shipping_nova_poshta_auto_ttn_status_id %} selected{% endif %}>{{ s.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>

          <h5 class="text-muted mb-3 mt-4"><i class="fa-solid fa-tag"></i> {{ text_section_pricing }}</h5>
          <div class="row mb-3">
            <label for="input-default-cost" class="col-sm-2 col-form-label">{{ entry_default_cost }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_nova_poshta_default_cost" value="{{ shipping_nova_poshta_default_cost }}" placeholder="0.00" id="input-default-cost" class="form-control"/>
            </div>
          </div>

          <h5 class="text-muted mb-3 mt-4"><i class="fa-solid fa-palette"></i> {{ text_section_appearance }}</h5>
          <div class="row mb-3">
            <label for="input-accent-color" class="col-sm-2 col-form-label">{{ entry_accent_color }}</label>
            <div class="col-sm-10">
              <div class="input-group" style="max-width:240px;">
                <input type="color" name="shipping_nova_poshta_accent_color" value="{{ shipping_nova_poshta_accent_color }}" id="input-accent-color" class="form-control form-control-color" oninput="document.getElementById('input-accent-color-hex').value=this.value"/>
                <input type="text" value="{{ shipping_nova_poshta_accent_color }}" id="input-accent-color-hex" class="form-control" readonly/>
              </div>
              <div class="form-text">{{ help_accent_color }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-np-radius" class="col-sm-2 col-form-label">{{ entry_radius }}</label>
            <div class="col-sm-10">
              <div class="input-group" style="max-width:280px;">
                <input type="range" min="0" max="28" step="1" name="shipping_nova_poshta_radius" value="{{ shipping_nova_poshta_radius }}" id="input-np-radius" class="form-range align-self-center me-3" style="flex:1;" oninput="document.getElementById('np-radius-val').textContent=this.value+'px'"/>
                <span id="np-radius-val" class="badge bg-secondary align-self-center">{{ shipping_nova_poshta_radius }}px</span>
              </div>
              <div class="form-text">{{ help_radius }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-np-theme" class="col-sm-2 col-form-label">{{ entry_theme }}</label>
            <div class="col-sm-10">
              <select name="shipping_nova_poshta_theme" id="input-np-theme" class="form-select" style="max-width:280px;">
                <option value="auto"{% if shipping_nova_poshta_theme == 'auto' %} selected{% endif %}>{{ text_theme_auto }}</option>
                <option value="light"{% if shipping_nova_poshta_theme == 'light' %} selected{% endif %}>{{ text_theme_light }}</option>
                <option value="dark"{% if shipping_nova_poshta_theme == 'dark' %} selected{% endif %}>{{ text_theme_dark }}</option>
              </select>
              <div class="form-text">{{ help_theme }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-tax-class" class="col-sm-2 col-form-label">{{ entry_tax_class }}</label>
            <div class="col-sm-10">
              <select name="shipping_nova_poshta_tax_class_id" id="input-tax-class" class="form-select">
                <option value="0">{{ text_none|default('None') }}</option>
                {% for tax_class in tax_classes %}
                  <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == shipping_nova_poshta_tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="shipping_nova_poshta_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones|default('All Zones') }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == shipping_nova_poshta_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="shipping_nova_poshta_status" value="0"/>
                <input type="checkbox" name="shipping_nova_poshta_status" value="1" id="input-status" class="form-check-input"{% if shipping_nova_poshta_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_nova_poshta_sort_order" value="{{ shipping_nova_poshta_sort_order }}" placeholder="0" id="input-sort-order" class="form-control"/>
            </div>
          </div>

          <h5 class="text-muted mb-3 mt-4"><i class="fa-solid fa-certificate"></i> {{ text_section_license }}</h5>
          <div class="row mb-3">
            <label for="input-license-key" class="col-sm-2 col-form-label">{{ entry_license_key }}</label>
            <div class="col-sm-10">
              <div class="input-group">
                <input type="text" name="shipping_nova_poshta_license_key" value="{{ shipping_nova_poshta_license_key }}" placeholder="XXXX-XXXX-XXXX-XXX" id="input-license-key" class="form-control" autocomplete="off"/>
                <button type="button" id="button-license" data-url="{{ url_license_check }}" class="btn btn-outline-secondary"><i class="fa-solid fa-shield-halved"></i> {{ button_license }}</button>
              </div>
              <div id="license-result" class="form-text">
                {% if shipping_nova_poshta_license_status %}
                  {{ text_license_current_status }} <strong>{{ shipping_nova_poshta_license_status }}</strong>
                {% endif %}
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
(() => {
  const setResult = (el, msg, cls) => { el.textContent = msg; el.className = 'form-text ' + cls; };
  // The key currently typed in the form. Every helper below sends it so a
  // just-pasted key works before the settings are saved — otherwise the tools
  // silently query with the stored (possibly empty) key.
  const currentKey = () => (document.getElementById('input-api-key').value || '').trim();

  const post = (url, body) => {
    const payload = Object.assign({shipping_nova_poshta_api_key: currentKey()}, body || {});
    return fetch(url, {
      method: 'POST',
      headers: {'Content-Type':'application/x-www-form-urlencoded','X-Requested-With':'XMLHttpRequest'},
      credentials: 'same-origin',
      body: new URLSearchParams(payload)
    }).then(r => r.json());
  };

  const btnTest = document.getElementById('button-test');
  btnTest.addEventListener('click', () => {
    const url = btnTest.dataset.testUrl;
    const key = document.getElementById('input-api-key').value.trim();
    const r = document.getElementById('test-result');
    setResult(r, '...', 'text-muted');
    post(url, {shipping_nova_poshta_api_key: key})
      .then(d => setResult(r, d.success || d.error, d.success ? 'text-success' : 'text-danger'))
      .catch(e => setResult(r, 'err: ' + e.message, 'text-danger'));
  });

  const btnSetup = document.getElementById('button-setup');
  if (btnSetup) {
    btnSetup.addEventListener('click', () => {
      const url = btnSetup.dataset.url;
      const r = document.getElementById('setup-result');
      r.textContent = '...';
      post(url).then(d => {
        r.textContent = d.success || d.error;
        r.className = 'ms-2 ' + (d.success ? 'text-success' : 'text-danger');
      });
    });
  }

  const btnSearch = document.getElementById('button-search-city');
  const cityInput = document.getElementById('input-city-search');
  const cityResults = document.getElementById('city-results');
  const hCityRef = document.getElementById('input-sender-city-ref');
  const hCityName= document.getElementById('input-sender-city-name');
  const whSelect = document.getElementById('input-sender-warehouse');
  const hWhRef   = document.getElementById('input-sender-warehouse-ref');
  const hWhName  = document.getElementById('input-sender-warehouse-name');

  const loadWh = (cityRef) => {
    if (!cityRef) return;
    whSelect.innerHTML = '<option value="">...</option>';
    post(whSelect.dataset.url, {city_ref: cityRef}).then(d => {
      whSelect.innerHTML = '<option value="">—</option>';
      const want = whSelect.dataset.selectedRef || hWhRef.value;
      (d.warehouses || []).forEach(w => {
        const o = document.createElement('option');
        o.value = w.ref; o.textContent = w.description;
        if (w.ref === want) o.selected = true;
        whSelect.appendChild(o);
      });
    });
  };

  btnSearch.addEventListener('click', () => {
    const url = btnSearch.dataset.url;
    const q = cityInput.value.trim();
    cityResults.innerHTML = ''; cityResults.style.display = 'block';
    post(url, {q: q}).then(d => {
      cityResults.innerHTML = '';
      if (d.error) { cityResults.innerHTML = '<div class="list-group-item text-danger">' + d.error + '</div>'; return; }
      if (!d.cities || !d.cities.length) { cityResults.innerHTML = '<div class="list-group-item text-muted">no results</div>'; return; }
      d.cities.forEach(c => {
        const a = document.createElement('a');
        a.href = '#'; a.className = 'list-group-item list-group-item-action';
        a.textContent = c.name + (c.area ? ' (' + c.area + ')' : '');
        a.addEventListener('click', (e) => {
          e.preventDefault();
          hCityRef.value = c.ref; hCityName.value = c.name;
          cityInput.value = c.name; cityResults.style.display = 'none';
          whSelect.dataset.selectedRef = ''; hWhRef.value = ''; hWhName.value = '';
          loadWh(c.ref);
        });
        cityResults.appendChild(a);
      });
    });
  });
  cityInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') { e.preventDefault(); btnSearch.click(); }});

  whSelect.addEventListener('change', () => {
    hWhRef.value = whSelect.value;
    hWhName.value = whSelect.options[whSelect.selectedIndex] ? whSelect.options[whSelect.selectedIndex].textContent : '';
  });

  // Auto-load warehouses if city already set and dropdown empty.
  if (hCityRef.value && (whSelect.options.length <= 1)) {
    loadWh(hCityRef.value);
  }

  const btnQuote = document.getElementById('button-quote');
  const quoteR = document.getElementById('quote-result');
  btnQuote.addEventListener('click', () => {
    const url = btnQuote.dataset.url;
    quoteR.textContent = '...'; quoteR.className = 'ms-2 text-muted';
    post(url).then(d => {
      quoteR.textContent = d.success || d.error;
      quoteR.className = 'ms-2 ' + (d.success ? 'text-success' : 'text-danger');
    });
  });

  // Sender counterparty + contact loaders
  const cpSel = document.getElementById('input-sender-cp');
  const cpRefHidden = document.getElementById('input-sender-cp-ref');
  const cpNameHidden = document.getElementById('input-sender-cp-name');
  const contactSel = document.getElementById('input-sender-contact');
  const contactRefHidden = document.getElementById('input-sender-contact-ref');
  const contactNameHidden = document.getElementById('input-sender-contact-name');
  const senderPhone = document.getElementById('input-sender-phone');

  const loadCps = () => {
    cpSel.innerHTML = '<option value="">...</option>';
    post(cpSel.dataset.url).then(d => {
      cpSel.innerHTML = '<option value="">—</option>';
      const want = cpSel.dataset.selectedRef || cpRefHidden.value;
      (d.counterparties || []).forEach(c => {
        const o = document.createElement('option');
        o.value = c.ref; o.textContent = c.name + (c.type ? ' (' + c.type + ')' : '');
        if (c.ref === want) o.selected = true;
        cpSel.appendChild(o);
      });
      if (cpSel.value) loadContacts(cpSel.value);
    });
  };
  const loadContacts = (cpRef) => {
    contactSel.innerHTML = '<option value="">...</option>';
    post(contactSel.dataset.url, {counterparty_ref: cpRef}).then(d => {
      contactSel.innerHTML = '<option value="">—</option>';
      const want = contactSel.dataset.selectedRef || contactRefHidden.value;
      (d.contacts || []).forEach(c => {
        const o = document.createElement('option');
        o.value = c.ref; o.textContent = c.name; o.dataset.phone = c.phone || '';
        if (c.ref === want) o.selected = true;
        contactSel.appendChild(o);
      });
      if (contactSel.value && contactSel.selectedOptions[0]?.dataset.phone) {
        if (!senderPhone.value) senderPhone.value = contactSel.selectedOptions[0].dataset.phone;
      }
    });
  };
  document.getElementById('button-load-cp').addEventListener('click', loadCps);
  cpSel.addEventListener('change', () => {
    cpRefHidden.value = cpSel.value;
    cpNameHidden.value = cpSel.selectedOptions[0]?.textContent || '';
    contactSel.dataset.selectedRef = '';
    contactRefHidden.value = '';
    contactNameHidden.value = '';
    if (cpSel.value) loadContacts(cpSel.value);
  });
  contactSel.addEventListener('change', () => {
    contactRefHidden.value = contactSel.value;
    contactNameHidden.value = contactSel.selectedOptions[0]?.textContent || '';
    const phone = contactSel.selectedOptions[0]?.dataset.phone || '';
    if (phone) senderPhone.value = phone;
  });
  // Auto-load counterparties on page load if API key configured but no CP picked yet
  if (!cpRefHidden.value && document.getElementById('input-api-key').value.trim()) {
    loadCps();
  }

  const btnLicense = document.getElementById('button-license');
  if (btnLicense) {
    btnLicense.addEventListener('click', () => {
      const url = btnLicense.dataset.url;
      const key = document.getElementById('input-license-key').value.trim();
      const r = document.getElementById('license-result');
      r.textContent = '...'; r.className = 'form-text text-muted';
      post(url, {shipping_nova_poshta_license_key: key}).then(d => {
        r.textContent = d.success || d.error;
        r.className = 'form-text ' + (d.success ? 'text-success' : 'text-danger');
      });
    });
  }
})();
</script>
{{ footer }}
